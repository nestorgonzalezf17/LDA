@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..U8D8LcaKdTy6QjQhB_welTDh7wqHkTq3H7Y4iYyJfRo

GET {{baseUrl}}/notificaciones HTTP/1.1
Authorization: Bearer {{token}}
